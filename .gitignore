scripts/optimize_theme_assets.py
scripts/fix_stranger_variant_paths.py
scripts/reorganize_mp3li_themes.py
scripts/write_theme_index_shells.py
scripts/generate-theme-index-redirects.ps1
scripts/deploy-upload-worker.sh
_bulk_update_theme_pages.py

